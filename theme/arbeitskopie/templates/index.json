      "settings": {
        "custom_liquid": "<div class=\"he-faq\">\n  <div class=\"he-faq__inner\">\n    <p class=\"he-faq__eyebrow\">FAQ</p>\n    <h2 class=\"he-faq__title\">Häufige Fragen</h2>\n\n    <details class=\"he-faq__item\"><summary>Wie lange dauert der Versand?</summary>\n      <div class=\"he-faq__answer\">In der Regel 2 bis 5 Werktage. Die genaue Lieferzeit steht zusätzlich auf jeder Produktseite.</div></details>\n    <details class=\"he-faq__item\"><summary>Ist der Versand kostenlos?</summary>\n      <div class=\"he-faq__answer\">Ja, innerhalb Deutschlands versenden wir kostenlos.</div></details>\n    <details class=\"he-faq__item\"><summary>Welche Zahlungsmethoden gibt es?</summary>\n      <div class=\"he-faq__answer\">Kreditkarte (Visa, Mastercard und weitere), PayPal, Klarna, Shop Pay, Google Pay und Banküberweisung. Auf Apple-Geräten zusätzlich Apple Pay. Die vollständige Liste sehen Sie im Bezahlvorgang.</div></details>\n    <details class=\"he-faq__item\"><summary>Kann ich meine Bestellung zurückgeben?</summary>\n      <div class=\"he-faq__answer\">Ja, Sie haben 30 Tage Rückgaberecht. Einzelheiten stehen in der Widerrufsbelehrung.</div></details>\n    <details class=\"he-faq__item\"><summary>Wie erreiche ich den Kundenservice?</summary>\n      <div class=\"he-faq__answer\">Per E-Mail. Wir antworten in der Regel innerhalb von 24 Stunden.</div></details>\n    <details class=\"he-faq__item\"><summary>Woher weiß ich, ob ein Möbel passt?</summary>\n      <div class=\"he-faq__answer\">Auf jeder Produktseite stehen Maße, Material und Belastbarkeit. Im Zweifel schreiben Sie uns die Maße Ihres Raums — wir sagen Ihnen, ob es passt.</div></details>\n  </div>\n</div>\n\n<style>\n  .he-faq { padding: 48px 0; background: #f8f6f3; }\n  .he-faq__inner { max-width: 820px; margin: 0 auto; padding: 0 20px; }\n  .he-faq__eyebrow { margin: 0 0 6px; font-size: 13px; font-weight: 700;\n    letter-spacing: .12em; text-transform: uppercase; color: #6f6355; text-align: center; }\n  .he-faq__title { margin: 0 0 26px; font-size: 30px; line-height: 1.15;\n    font-weight: 700; color: #111; text-align: center; }\n  .he-faq__item { background: #fff; border: 1px solid rgba(17,17,17,.07);\n    border-radius: 14px; margin-bottom: 10px; }\n  .he-faq__item summary { list-style: none; cursor: pointer; padding: 18px 46px 18px 20px;\n    font-size: 16px; font-weight: 600; color: #111; position: relative; }\n  .he-faq__item summary::-webkit-details-marker { display: none; }\n  .he-faq__item summary::after { content: \"+\"; position: absolute; right: 20px;\n    top: 50%; transform: translateY(-50%); font-size: 22px; color: #111; }\n  .he-faq__item[open] summary::after { content: \"\\2212\"; }\n  .he-faq__answer { padding: 0 20px 18px; font-size: 15px; line-height: 1.75; color: #444; }\n  @media screen and (max-width: 749px) {\n    .he-faq { padding: 36px 0; }\n    .he-faq__title { font-size: 24px; }\n    .he-faq__item summary { font-size: 15px; padding: 16px 42px 16px 16px; }\n    .he-faq__answer { padding: 0 16px 16px; font-size: 14px; }\n  }\n</style>",
